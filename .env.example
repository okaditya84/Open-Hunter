# ======================================================================
# Open Hunter — environment configuration
# Copy this file to ".env" and fill in your values.
# ======================================================================

# ----------------------------------------------------------------------
# LLM provider (OpenAI-compatible API).
# Works with OpenRouter, Groq, Ollama, DeepSeek, Together, Gemini's
# OpenAI-compatible endpoint, and any other OpenAI-compatible server.
# Only these three variables drive the whole LLM layer.
# ----------------------------------------------------------------------

# The base URL of your provider's OpenAI-compatible endpoint.
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   Ollama     : http://localhost:11434/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://openrouter.ai/api/v1

# Your API key for that provider. (Ollama accepts any non-empty string.)
LLM_API_KEY=sk-replace-me

# The model id, exactly as the provider expects it. Examples:
#   openrouter : deepseek/deepseek-chat   or   google/gemini-2.0-flash-001
#   groq       : llama-3.3-70b-versatile
#   ollama     : llama3.1
#   deepseek   : deepseek-chat
LLM_MODEL=deepseek/deepseek-chat

# Optional: max tokens per LLM response (default 2048).
LLM_MAX_TOKENS=2048
# Optional: temperature (default 0.0 — we want deterministic, factual output).
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------------------
# Crawl behaviour
# ----------------------------------------------------------------------

# Be a polite citizen: respect robots.txt where it forbids a path.
# (true / false). Default true.
RESPECT_ROBOTS=true

# Seconds to wait between requests to the same host (politeness).
REQUEST_DELAY_SECONDS=1.0

# Per-request HTTP timeout in seconds.
HTTP_TIMEOUT=25

# Enable the Playwright headless-browser fallback for JS-heavy pages.
# (true / false). Default true.
ENABLE_BROWSER=true

# How many companies to process concurrently. Keep modest to stay polite
# and within LLM rate limits. Default 4.
MAX_CONCURRENCY=4

# User-Agent sent with HTTP requests. A real, honest UA — we identify
# ourselves rather than impersonate a browser to evade detection.
USER_AGENT=OpenHunter/1.0 (+job-search-assistant)
