# ======================================================================
# Open Hunter — environment configuration
# Copy this file to ".env" and fill in your values.
# ======================================================================

# ----------------------------------------------------------------------
# LLM provider (OpenAI-compatible API).
# Works with OpenRouter, Groq, Ollama, DeepSeek, Together, Gemini's
# OpenAI-compatible endpoint, Amazon Bedrock, and any other
# OpenAI-compatible server. Only a few variables drive the whole LLM layer.
# ----------------------------------------------------------------------

# Which provider style to use: "openai" (default) or "bedrock".
# "bedrock" auto-fills the base URL from your region and reads the key from
# AWS_BEARER_TOKEN_BEDROCK if LLM_API_KEY is empty (see the Bedrock block).
LLM_PROVIDER=openai

# The base URL of your provider's OpenAI-compatible endpoint.
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   Ollama     : http://localhost:11434/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/
# (Leave blank when LLM_PROVIDER=bedrock to auto-build it from LLM_REGION.)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Your API key for that provider. (Ollama accepts any non-empty string.)
LLM_API_KEY=sk-replace-me

# The model id, exactly as the provider expects it. Examples:
#   openrouter : deepseek/deepseek-chat   or   google/gemini-2.0-flash-001
#   groq       : llama-3.3-70b-versatile
#   ollama     : llama3.1
#   deepseek   : deepseek-chat
LLM_MODEL=deepseek/deepseek-chat

# ----------------------------------------------------------------------
# Amazon Bedrock — uses the native Converse API (boto3), which exposes the
# FULL model catalog including Claude. To use it, set LLM_PROVIDER=bedrock
# above, leave LLM_BASE_URL blank, and fill ONLY these three things:
#   1) LLM_API_KEY  = your Bedrock API key  (or set AWS_BEARER_TOKEN_BEDROCK)
#   2) LLM_REGION   = the AWS region where you enabled model access
#   3) LLM_MODEL    = a Bedrock inference-profile / model id, e.g.:
#         us.anthropic.claude-sonnet-4-6           (Claude Sonnet 4.6)
#         us.anthropic.claude-sonnet-4-5-20250929-v1:0
#         us.meta.llama3-3-70b-instruct-v1:0       (Llama)
#         us.amazon.nova-pro-v1:0                  (Amazon Nova)
# Each model needs access granted on the Bedrock console "Model access" page.
# ----------------------------------------------------------------------
LLM_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=bedrock-...   # alternative to putting it in LLM_API_KEY

# Optional: max tokens per LLM response (default 2048).
LLM_MAX_TOKENS=2048
# Optional: temperature (default 0.0 — we want deterministic, factual output).
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------------------
# Crawl behaviour
# ----------------------------------------------------------------------

# Be a polite citizen: respect robots.txt where it forbids a path.
# (true / false). Default true.
RESPECT_ROBOTS=true

# Seconds to wait between requests to the same host (politeness).
REQUEST_DELAY_SECONDS=1.0

# Per-request HTTP timeout in seconds.
HTTP_TIMEOUT=25

# Enable the Playwright headless-browser fallback for JS-heavy pages.
# (true / false). Default true.
ENABLE_BROWSER=true

# How many companies to process concurrently. Keep modest to stay polite
# and within LLM rate limits. Default 4.
MAX_CONCURRENCY=4

# How many relevance-scoring batches to run concurrently against the LLM.
# Higher = faster matching, but watch your provider's rate limits. Default 8.
MATCHER_CONCURRENCY=8

# --- Auto-apply agent: visual form QA ---
# An image-capable model (OpenRouter) that looks at each filled form screenshot
# and reports any required field left empty / dropdown left unset.
VISION_MODEL=qwen/qwen3.5-9b
ENABLE_VISION=true

# User-Agent sent with HTTP requests. A real, honest UA — we identify
# ourselves rather than impersonate a browser to evade detection.
USER_AGENT=OpenHunter/1.0 (+job-search-assistant)
